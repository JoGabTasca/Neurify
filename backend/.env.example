# Server bind host and port
NEURIFY_BACKEND_HOST=127.0.0.1
NEURIFY_BACKEND_PORT=8000

# Execution mode: "mock" (default while awaiting notebook analysis) or "real"
NEURIFY_EXECUTION_MODE=mock

# Local path to the GPT-2 fine-tuned checkpoint directory
NEURIFY_CHECKPOINT_DIR=./checkpoints/gpt2-midi

# Local path to the MidiTok tokenizer configuration exported from the training notebook
NEURIFY_TOKENIZER_CONFIG=./checkpoints/gpt2-midi/tokenizer.json

# Local path to the FluidSynth SoundFont (.sf2) file
NEURIFY_SOUNDFONT_PATH=./soundfonts/default.sf2

# FluidSynth executable name or absolute path
NEURIFY_FLUIDSYNTH_BIN=fluidsynth

# Comma-separated list of allowed local frontend origins for CORS
NEURIFY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
